# Copy to .env before using compose.yml, then change every secret.
PORT=65534
DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-strong-root-password
AUTH_COOKIE_SECURE=false

# Public HTTPS origin used as the OAuth/OIDC issuer and in discovery metadata.
# Replace this with the exact externally reachable root URL, without a trailing slash.
AUTH_OAUTH_ISSUER=https://auth.example.com
# Optional. Defaults to /app/data/oauth-signing-key.pem inside the persistent data volume.
# AUTH_OAUTH_KEY_FILE=/app/data/oauth-signing-key.pem

# Optional. When empty, NekoAuth generates a one-time token and prints it in the startup log.
# AUTH_SETUP_TOKEN=
